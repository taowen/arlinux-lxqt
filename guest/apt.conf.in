Dir "@ROOT@";
Dir::State "var/lib/apt";
Dir::Cache "var/cache/apt";
Dir::Etc "etc/apt";
Dir::Log "var/log/apt";
DPkg::Pre-Install-Pkgs "";
DPkg::Post-Invoke "";
APT::Update::Post-Invoke-Success "";
Acquire::Languages "none";
APT::Install-Recommends "false";
APT::Install-Suggests "false";
APT::Sandbox::User "root";
